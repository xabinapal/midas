# Base URL (varies per environment: local dev vs production)
APP_BASE_URL="http://localhost:5173"

# One-time setup credential (server-only; remove or rotate after first setup)
# Must contain at least 32 UTF-8 bytes. Required only for the initial /setup flow.
# BOOTSTRAP_CREDENTIAL="generate-a-secure-random-string-of-at-least-32-bytes"

# Operator-assisted recovery credential (server-only; disabled by default)
# Must contain at least 32 UTF-8 bytes. Each credential can be used only once.
# RECOVERY_CREDENTIAL="generate-a-secure-random-string-of-at-least-32-bytes"
