#!/usr/bin/env sh
# Pre-commit gate: format the codebase, re-stage, then run every verification task.
# Aborts the commit if any step fails. Runs the same mise tasks used in development.
set -e

mise run format

# Re-stage files that were staged before formatting so formatting changes are committed.
git diff --cached --name-only --diff-filter=ACMR -z | xargs -0 git add

mise run lint
mise run check
mise run test

case "$(git diff --cached --name-only)" in
	*DESIGN.md*) mise run design-lint ;;
esac
